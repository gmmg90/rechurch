# Copia questo file in ".env" e compila i valori, poi: docker compose up -d --build

# Dominio (record A puntato all'IP del VPS)
DOMAIN=parrocchia.tuodominio.it

# Chiave per i token JWT — genera una stringa lunga casuale, es:
#   openssl rand -hex 32
SECRET_KEY=CAMBIA_CON_STRINGA_CASUALE_LUNGA

# Database: lascia vuoto per SQLite persistente (consigliato).
# Per Postgres: postgresql://utente:password@host:5432/dbname
DATABASE_URL=

# Account amministratore di sistema (owner) — non elencato in Utenti
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Backup cloud (opzionale): none | dropbox | gdrive  — vedi DEPLOY.md
CLOUD_BACKUP_PROVIDER=none
CLOUD_BACKUP_KEEP=30
# Dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Google Drive
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
