# ReChurch — impostazioni COMUNI a tutte le parrocchie del server.
# Copiato in /srv/rechurch/.env da "rechurch.sh init". Ogni parrocchia ha poi il
# proprio file parrocchie/<slug>.env, che può sovrascrivere questi valori.
# Dopo una modifica: sudo deploy/rechurch.sh up
#
# Nota: se un valore contiene "$" racchiudilo tra apici singoli ('...').

# Email per i certificati HTTPS di Let's Encrypt (avvisi di scadenza)
ACME_EMAIL=

# Dominio di base per i sottodomini delle parrocchie: con "rechurch.sh add <slug> auto"
# la parrocchia risponde su <slug>.<DOMINIO_BASE>. Con un record DNS jolly
# (*.tuodominio.it → IP del server) non serve toccare il DNS per ogni parrocchia.
DOMINIO_BASE=

# Pannello web del gestore: impostato da "rechurch.sh pannello installa"
#PANNELLO_DOMAIN=

# Fuso orario (orario dei backup notturni, date nei log)
TZ=Europe/Rome

# Account amministratore di sistema (owner/gestore tecnico). Viene creato in
# OGNI parrocchia, non compare nella pagina Utenti e non può essere eliminato.
# Lascia vuoto per non crearlo. Vedi DEPLOY.md §2c.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Memoria massima per ogni parrocchia (un'istanza usa tipicamente 120-200 MB)
MEM_LIMIT=512m

# Backup locali conservati nella cartella di ogni parrocchia (data/<slug>/backups)
BACKUP_KEEP_LOCAL=60
# Archivi conservati da "rechurch.sh backup" in /srv/rechurch/backups/<slug>
SERVER_BACKUP_KEEP=14

# ── Backup cloud off-site (consigliato: Kimsufi non include spazio di backup) ──
# none | dropbox | gdrive — vedi DEPLOY.md §2. Le credenziali sono comuni;
# ogni parrocchia scrive in una propria cartella (DROPBOX_FOLDER=/ReChurch/<slug>,
# impostato automaticamente, oppure GDRIVE_FOLDER_ID nel file della parrocchia).
CLOUD_BACKUP_PROVIDER=none
CLOUD_BACKUP_KEEP=30
# Dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Google Drive (OAuth utente)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
